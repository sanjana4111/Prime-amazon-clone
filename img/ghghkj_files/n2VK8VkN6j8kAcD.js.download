":"離線觀看已到期","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_MESSAGE":"無法使用的語言：{missingTracks}","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_TITLE":"無法使用其他語言","DV_WINAPP_NAV_HIDE_BUTTON":"隱藏","DV_WINAPP_OFFLINE_DESC":"移至「{link|/spa/downloads}下載{end}」以在裝置離線時觀看影片。","DV_WINAPP_OFFLINE_HEADING":"您的裝置目前離線","DV_WINAPP_OUT_OF_SPACE_ERROR_MESSAGE":"由於您裝置的儲存空間不足，因此我們無法下載影片。請刪除您不需要的項目或應用程式，然後再試一次。","DV_WINAPP_OUT_OF_SPACE_ERROR_TITLE":"沒有足夠的空間","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_MESSAGE":"此影片無法播放。","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_TITLE":"無法觀看影片","DV_WINAPP_PLAYMODAL_CTA":"立即觀看","DV_WINAPP_PLAYMODAL_HEAD":"開始 {hours} 小時離線觀看時限","DV_WINAPP_PLAYRENTALMODAL_DESC":"您即將開始此影片的 {hours} 小時租借期。","DV_WINAPP_PLAYRENTALMODAL_SUBDESC":"注意： 此影片只能下載到一部裝置，但可從任何支援的裝置線上觀看。","DV_WINAPP_SELECT_ALL":"選取全部","DV_WINAPP_SETTINGS":"設定","DV_WINAPP_SETTINGS_DOWNLOADS":"Prime Video 下載","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_MESSAGE":"在繼續之前，您必須接受 {brand} 的使用條款。","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_TITLE":"不接受條款"},"com.amazon.dvweb.strings.mxplayer":{"DV_WEB_MX_DATA_SYNC_FALLBACK":"MX Player 的內容無法同步。請重新整理頁面，然後再試依次。","DV_WEB_MX_REDIRECT_BODY":"請稍候，我們正在同步您的資料。","DV_WEB_MX_REDIRECT_HEADER":"Amazon MX Player 現已更名為 Prime Video。"},"com.amazon.dvweb.strings.server":{},"com.amazon.dvweb.strings.xdsso":{"DV_WEB_XDSSO_BANNER_TEXT":"您目前透過 Amazon 以 {name} 的身分登入。不是您本人嗎？","DV_WEB_XDSSO_LOCKED_PROFILE_BANNER_TEXT":"您目前透過 Amazon 登入。不是您本人嗎？","DV_WEB_XDSSO_SIGN_OUT":"登出"}}}')},98311:function(e){e.exports=JSON.parse('{"und":{"com.amazon.dvweb.strings.accessibility":{"DV_WEB_DISMISS_BANNER":"Dismiss banner"},"com.amazon.dvweb.strings.deviceregistration":{"DV_WEB_DEVICE_REGISTRATION_BACK":"Go back","DV_WEB_DEVICE_REGISTRATION_CODEPAIR_ERROR":"We\'re unable to get a sign-in code right now. Please try again.","DV_WEB_DEVICE_REGISTRATION_COUNTDOWN":"Code expires in {time}","DV_WEB_DEVICE_REGISTRATION_EXPIRED_ERROR":"Your sign-in code expired.","DV_WEB_DEVICE_REGISTRATION_HEADING":"Sign in with your phone","DV_WEB_DEVICE_REGISTRATION_INS