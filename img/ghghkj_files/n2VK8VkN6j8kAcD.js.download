DV_WEB_DOWNLOADS_MIGRATION_DOWNLOADED_HEADER":"பதிவிறக்கப்பட்ட வீடியோக்கள்","DV_WEB_DOWNLOADS_MIGRATION_RESTORE":"மீட்டெடு","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_DOWNLOAD":"பதிவிறக்கத்தை மீட்டெடு","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_HEADER":"பதிவிறக்கப்பட்ட உங்கள் வீடியோக்களை மீட்டெடுங்கள்","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_SUBHEADER":"இந்தச் செயலியில் பார்க்க, உங்கள் முந்தைய பதிவிறக்கங்கள் மீண்டும் பதிவிறக்கப்பட வேண்டும்.","DV_WEB_DOWNLOADS_NOT_SUPPORTED":"இந்தச் சாதனத்தில் பதிவிறக்கங்கள் ஆதரிக்கப்படவில்லை.","DV_WEB_DOWNLOADS_SEASON_EPISODE_TEMPLATE":"சீ{seasonNumber} எ{episodeNumber}","DV_WEB_OFFLINE_ERROR_DOWNLOADS_BUTTON":"பதிவிறக்கங்கள் பக்கத்திற்குச் செல்லவும்","DV_WEB_OFFLINE_ERROR_HEADER":"உங்கள் சாதனம் தற்போது ஆஃப்லைனில் உள்ளது.","DV_WEB_OFFLINE_ERROR_SUBHEADER_DOWNLOADS":"உங்கள் வீடியோக்களைப் பார்க்க, பதிவிறக்கங்களுக்குச் செல்லவும்.","DV_WEB_OFFLINE_ERROR_SUBHEADER_NO_DOWNLOADS":"உங்கள் சாதனம் மீண்டும் ஆன்லைனில் இருக்கும்போது மீண்டும் முயலவும்.","DV_WEB_download_pin_error_title":"பதிவிறக்குவதில் பிழை","DV_WEB_download_restriction_error_description":"உங்கள் தலைப்பைப் பதிவிறக்குவதில் சிக்கல் உள்ளது. தயவுசெய்து மீண்டும் முயற்சிக்கவும். இப்பிரச்சனை தொடர்ந்தால், {link|contactUs}Amazon வாடிக்கையாளர் சேவையைத் தொடர்புகொண்டு{end}, 5015 எனும் பிழை எண்ணைக் குறிப்பிடவும்.","DV_WINAPP_ACTION_CANCELLED":"ரத்து செய்யப்பட்டது","DV_WINAPP_ACTION_CANCELLED_EPISODES":"{episodeText} ரத்து செய்யப்பட்டது","DV_WINAPP_ACTION_COMPLETED":"நீக்கு","DV_WINAPP_ACTION_COMPLETED_EPISODES":"{episodeText}-ஐ நீக்கு","DV_WINAPP_ACTION_COMPLETED_SEASON":"பதிவிறக்கம் {seasonNumber} சீசன்","DV_WINAPP_ACTION_DOWNLOADING":"பதிவிறக்குகிறது","DV_WINAPP_ACTION_DOWNLOADING_EPISODES":"{episodeText}-ஐப் பதிவிறக்குகிறது","DV_WINAPP_ACTION_DOWNLOADING_SEASON":"சீசன் {seasonNumber}-ஐப் பதிவிறக்குகிறது ","DV_WINAPP_ACTION_ERROR":"பிழை","DV_WINAPP_ACTION_ERROR_EPISODES":"{episodeText} பதிவிறக்கும்போது பிழை","DV_WINAPP_ACTION_ERROR_SEASON":"சில சீசன் {seasonNumber} பதிவிறக்கங்கள் தோல்வியுற்றன","DV_WINAPP_ACTION_IDLE":"பதிவிறக்கு","DV_WINAPP_ACTION_IDLE_EPISODES":"{episodeText}-ஐப் பதிவிறக்கு","DV_WINAPP_ACTION_IDLE_SEASON":"சீசன் {seasonNumber}-ஐப் பதிவிறக்கவும்","DV_WINAPP_ACTION_PAUSED":"மீண்டும் தொடங்கு","DV_WINAPP_ACTION_PAUSED_EPISODES":"{episodeText}-ஐ மீண்டும் தொடங்கு","DV_WINAPP_ACTION_QUEUED":"வரிசையிலுள்ளது","DV_WINAPP_ACTION_QUEUED_EPISODES":"{episodeText} வரிசையிலுள்ளது","DV_WINAPP_ACTION_QUEUED_SEASON":"வரிசையில் உள்ள சீசன் {seasonNumber}","DV_WINAPP_ACTION_REMOVED":"நீக்கப்பட்ட","DV_WINAPP_ACTION_REMOVED_EPISODES":"நீக்கப்பட்ட {episodeText}","DV_WINAPP_ACTION_WAITING":"காத்திருக்கிறது","DV_WINAPP_BACKBUTTON":"பின்செல் பொத்தான்","DV_WINAPP_CANCEL_BUTTON":"ரத்து செய்","DV_WINAPP_DELETE_BUTTON":"நீக்கு ({numItems})","DV_WINAPP_DESELECT_ALL":"அனைத்தையும் தேர்வுநீக்கு","DV_WINAPP_DOWNLOADS":"பதிவிறக்கங்கள்","DV_WINAPP_DOWNLOADS_AUDIO":"ஆடியோ ட்ராக்குகள்","DV_WINAPP_DOWNLOADS_EMPTY_CTA":"பதிவிறக்கம் செய்ய எதையாவது கண்டறியவும்","DV_WINAPP_DOWNLOADS_EMPTY_DESCRIPTION":"பதிவிறக்கப்பட்ட வீடியோக்களை எங்கும் பார்க்கலாம், அதற்கு இணைய இணைப்பு தேவையில்லை.","DV_WINAPP_DOWNLOADS_EMPTY_SUMMARY":"இன்னும் வீடியோக்கள் எதுவும் பதிவிறக்கப்படவில்லை...","DV_WINAPP_DOWNLOADS_QUALITY":"தரம்: {Quality}","DV_WINAPP_DOWNLOADS_SEASON_TAB":"சீசன் {seasonNumber}","DV_WINAPP_DOWNLOADS_SUBTITLES":"சப்டைட்டில்கள்","DV_WINAPP_DOWNLOAD_ERROR":"பதிவிறக்குவதில் பிழை","DV_WINAPP_DOWNLOAD_HIDE_EXTRA":"பிற பதிவிறக்கங்களை மறை","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_MESSAGE":"இந்தச் சந்தாவிற்குக் கிடைக்கக்கூடிய சேமிக்கப்பட்ட பதிவிறக்கங்களின் அதிகபட்ச எண்ணிக்கையில் நீங்கள் இருக்கிறீர்கள். பதிவிறக்க, இந்தச் சந்தாவிலிருந்து பதிவிறக்கியுள்ள ஒரு தலைப்பை நீக்கி, பின்னர் மீண்டும் முயலவும்.","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_TITLE":"பதிவிறக்க வரம்பை மீறிவிட்டது","DV_WINAPP_DOWNLOAD_QUALITY":"பதிவிறக்கல் தரம்","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK":"எப்போதும் கேள்","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK_DESCRIPTION":"ஒவ்வொரு பதிவிறக்கத்திற்கும் பதிவிறக்கத் தரத்தைத் தேர்ந்தெடுக்கவும்","DV_WINAPP_DOWNLOAD_QUALITY_BEST":"முதன்மையானது","DV_WINAPP_DOWNLOAD_QUALITY_BEST_DESCRIPTION":"1 மணி நேர வீடியோ சுமார் 2.4 ஜி.பி தரவு மற்றும் சேமிப்பகத்தைப் பயன்படுத்துகிறது","DV_WINAPP_DOWNLOAD_QUALITY_BETTER":"சிறந்தது","DV_WINAPP_DOWNLOAD_QUALITY_BETTER_DESCRIPTION":"1 மணிநேர வீடியோ சுமார் 1.1 ஜி.பி தரவு மற்றும் சேமிப்பகத்தைப் பயன்படுத்துகிறது","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER":"தரவுச் சேமிப்பான்","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER_DESCRIPTION":"1 மணிநேர வீடியோ ஏறத்தாழ 0.3 GB தரவு மற்றும் சேமிப்பகத்தைப் பயன்படுத்துகிறது","DV_WINAPP_DOWNLOAD_QUALITY_GOOD":"நல்லது","DV_WINAPP_DOWNLOAD_QUALITY_GOOD_DESCRIPTION":"1 மணி நேர வீடியோ சுமார் 0.5 ஜி.பி தரவு மற்றும் சேமிப்பகத்தைப் பயன்படுத்துகிறது","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ADDITIONAL_LANG_INFO":"கூடுதல் மொழிகள் உங்கள் பதிவிறக்கத்தில் சேர்க்கப்படலாம்.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DEFAULT_LANG_MISSING":"{displayName} கிடைக்கவில்லை.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DOWNLOAD_BUTTON_LABEL":"பதிவிறக்கத் தொடங்கு","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_MESSAGE":"பதிவிறக்கங்கள் பக்கத்தில் எப்போது வேண்டுமானாலும் பதிவிறக்கத் தேர்வுகளை நிர்வகிக்கலாம்.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_ADDITIONAL_LANG":"கூடுதல் மொழி இல்லை","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_AUDIO_LANG":"பதிவிறக்க, ஓர் ஆடியோ மொழியைத் தேர்வுசெய்யவும்","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_OPTIONS_AUDIO":"ஆடியோ மொழிகள்","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_AVAILABLE":"இயல்புநிலையில் {displayName} பதிவிறக்கப்படும்.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_MISSING":"இந்த வீடியோவிற்கான அசல் மொழி கிடைக்கவில்லை.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_SET_DEFAULT":"இயல்புநிலையாக அமை","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_TITLE":"{title}-க்கான பதிவிறக்கத் தேர்வுகள்","DV_WINAPP_DOWNLOAD_SETTINGS_RESET":"கூடுதல் ஆடியோ மொழியைப் பதிவிறக்கு","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_BUTTON":"மொழித் தேர்வை மீட்டமை","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_LABEL":"இன்னும் அமைக்கப்படவில்லை","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_MESSAGE":"நாங்கள் வீடியோவின் அசல் ஆடியோ மொழியைத் தானாகவே பதிவிறக்குகிறோம். (கிடைக்கும்போது) ஒரு கூடுதல் முன்னுரிமையான மொழியை நீங்கள் பதிவிறக்கத் தேர்வுசெய்யலாம் மற்றும் பதிவிறக்கச் சாளரத்தில் அதை இயல்புநிலையாக அமைக்கலாம்.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MESSAGE":"வீடியோவின் அசல் ஆடியோ மொழி மற்றும் (கிடைக்கும்போது) உங்கள் கூடுதல் முன்னுரிமையான மொழியைப் பதிவிறக்குவோம்.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_DISMISS_BUTTON":"ரத்துசெய்","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_MESSAGE":"அடுத்த முறை நீங்கள் ஒரு வீடியோவைப் பதிவிறக்கும்போது, முன்னுரிமையான கூடுதல் மொழியைத் தேர்வுசெய்யுமாறு நாங்கள் உங்களிடம் கேட்போம்.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_RESET_BUTTON":"சரி","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_TITLE":"நீங்கள் நிச்சயமாக மீட்டமைக்க விரும்புகிறீர்களா?","DV_WINAPP_DOWNLOAD_SHOW_EXTRA":"மற்ற பதிவிறக்கங்களைக் காண்பி","DV_WINAPP_DROPLIST_CANCELDL":"பதிவிறக்கத்தை ரத்துசெய்","DV_WINAPP_DROPLIST_DELETEDL":"பதிவிறக்கத்தை நீக்கு","DV_WINAPP_DROPLIST_ERROR":"பிழை விவரங்களைக் காண்க","DV_WINAPP_DROPLIST_PAUSEDL":"பதிவிறக்கத்தை இடைநிறுத்து","DV_WINAPP_DROPLIST_PLAY":"இயக்கு","DV_WINAPP_DROPLIST_RESUMEDL":"பதிவிறக்கத்தை மீள்துவக்கு","DV_WINAPP_DROPLIST_RETRYDL":"பதிவிறக்க மீண்டும் முயற்சிக்கவும்","DV_WINAPP_DROPLIST_STARTDL":"பதிவிறக்கத்தைத் தொடங்கு","DV_WINAPP_DROPLIST_VIEWDETAIL":"விவரங்களைக் காண்க","DV_WINAPP_DURATION":"{hours}ம.நே {minutes}நிமி","DV_WINAPP_EDIT_BUTTON":"திருத்து","DV_WINAPP_EPISODE_BONUS":"போனஸ் எபிசோட்","DV_WINAPP_EPISODE_NB":"எப்பிசோடு {episodeNumber}","DV_WINAPP_FIND_MORE_EPISODES":"கூடுதல் எப்பிசோடுகளைக் காண்க","DV_WINAPP_GENERIC_ERROR_MESSAGE":"தயவுசெய்து உங்கள் கோரிக்கையை சில நிமிடங்களில் மீண்டும் முயற்சிக்கவும் அல்லது {contactUsUrl}-இல் {brand} வாடிக்கையாளர் சேவையைத் தொடர்பு கொள்ளவும்.","DV_WINAPP_GENERIC_ERROR_TITLE":"பிரச்சனை ஏற்பட்டுள்ளது","DV_WINAPP_GENERIC_PLAYBACK_ERROR_MESSAGE":"எங்களால் இப்போது உங்கள் வீடியோவை இயக்க முடியவில்லை. தயவுசெய்து சில நிமிடங்களுக்குப் பின்னர் முயற்சிக்கவும். பிரச்சனை தொடர்ந்தால், {contactUsUrl}-இல் {brand} வாடிக்கையாளர் சேவையைத் தொடர்பு கொள்ளவும்.","DV_WINAPP_GENERIC_PLAYBACK_ERROR_TITLE":"வீடியோ இல்லை","DV_WINAPP_HAMBURGER":"மெனு","DV_WINAPP_INVALID_GEO_IP_ERROR_MESSAGE":"புவியியல் உரிம கட்டுப்பாடுகள் காரணமாக இந்த வீடியோ பதிவிறக்குவதற்கு இல்லை. மேலும் விவரங்களுக்கு, {brand} பயன்பாட்டு விதிகளைப் பார்க்கவும். மேலும் உதவிக்கு, {contactUsUrl}-இல் {brand} வாடிக்கையாளர் சேவையைத் தொடர்புகொள்ளவும்.","DV_WINAPP_INVALID_GEO_IP_ERROR_TITLE":"சேவைப் பகுதிக் கட்டுப்பாடு","DV_WINAPP_LICENSE_EXPIRED_ERROR_MESSAGE":"இந்த வீடியோவை ஆஃப்லைனில் பார்ப்பது காலாவதியானது. தயவுசெய்து உங்கள் சாதனத்தை இணையத்துடன் இணைத்து, பின்னர் ஆஃப்லைனில் பார்ப்பதை மீண்டும் இயக்க வீடியோவை இயக்கவும்.","DV_WINAPP_LICENSE_EXPIRED_ERROR_TITLE":"ஆஃப்லைனில் பார்ப்பது காலாவதியானது","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_MESSAGE":"கிடைக்கப்பெறாத மொழிகள்: {missingTracks}","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_TITLE":"கூடுதல் மொழிகள் கிடைக்கவில்லை","DV_WINAPP_NAV_BACK_BUTTON":"பின்செல்","DV_WINAPP_NAV_HIDE_BUTTON":"மறை","DV_WINAPP_OFFLINE_DESC":"உங்கள் சாதனம் ஆஃப்லைனில் இருக்கும் போது வீடியோக்களைப் பார்க்க {link|/spa/downloads}பதிவிறக்கங்கள்{end} என்பதற்குச் செல்லவும்.","DV_WINAPP_OFFLINE_HEADING":"உங்கள் சாதனம் தற்போது ஆஃப்லைனில் உள்ளது","DV_WINAPP_OUT_OF_SPACE_ERROR_MESSAGE":"உங்கள் சாதனத்தில் சேமிப்பக இடம் குறைவாக இருப்பதால் வீடியோவைப் பதிவிறக்க முடியவில்லை. உங்களுக்குத் தேவையில்லாத உருப்படிகள் அல்லது செயலிகளை நீக்கிவிட்டு, மீண்டும் முயற்சிக்கவும்.","DV_WINAPP_OUT_OF_SPACE_ERROR_TITLE":"போதிய இடவசதி இல்லை","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_MESSAGE":"இந்த வீடியோ பார்ப்பதற்கு இல்லை.","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_TITLE":"வீடியோ இல்லை","DV_WINAPP_PLAYMODAL_CANCEL":"ரத்து செய்","DV_WINAPP_PLAYMODAL_CTA":"இப்போது காண்க","DV_WINAPP_PLAYMODAL_HEAD":"{hours}ம.நே ஆஃப்லைனில் பார்க்கும் காலத்தைத் தொடங்குக","DV_WINAPP_PLAYRENTALMODAL_DESC":"இந்த வீடியோவிற்கான {hours}-மணிநேர வாடகைக் காலத்தை நீங்கள் தொடங்க உள்ளீர்கள்.","DV_WINAPP_PLAYRENTALMODAL_SUBDESC":"குறிப்பு: இந்த வீடியோவை ஒரு சாதனத்தில் மட்டுமே பதிவிறக்க முடியும், ஆனால் ஆதரவளிக்கப்பட்ட எந்தவொரு சாதனத்திலிருந்தும் ஆன்லைனில் பார்க்க முடியும்.","DV_WINAPP_SELECT_ALL":"எல்லாம் தேர்ந்தெடு","DV_WINAPP_SETTINGS":"அமைப்புகள்","DV_WINAPP_SETTINGS_DOWNLOADS":"Prime Video பதிவிறக்கங்கள்","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_MESSAGE":"தொடர்வதற்கு முன் நீங்கள் {brand} பயன்பாட்டு விதிகளை ஏற்க வேண்டும்.","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_TITLE":"நிபந்தனைகள் ஏற்கப்படவில்லை"},"com.amazon.dvweb.strings.mxplayer":{"DV_WEB_MX_DATA_SYNC_FALLBACK":"MX Player-இலிருந்து உங்கள் உள்ளடக்கத்தை ஒத்திசைக்க முடியவில்லை. பக்கத்தைப் புதுப்பிப்பதன் மூலம் மீண்டும் முயலவும்.","DV_WEB_MX_REDIRECT_BODY":"நாங்கள் உங்கள் தரவை ஒத்திசைக்கும் வரை காத்திருக்கவும்.","DV_WEB_MX_REDIRECT_HEADER":"Amazon MX Player இப்போது Prime Video-ஆக மாறிவிட்டது."},"com.amazon.dvweb.strings.server":{"DV_WEB_brand_pv":"Prime Video"},"com.amazon.dvweb.strings.xdsso":{"DV_WEB_XDSSO_BANNER_TEXT":"நீங்கள் Amazon மூலம் {name}-ஆக உள்நுழைந்துள்ளீர்கள். இல்லையா?","DV_WEB_XDSSO_LOCKED_PROFILE_BANNER_TEXT":"Amazon மூலம் உள்நுழைந்துள்ளீர்கள். நீங்கள் இல்லையா?","DV_WEB_XDSSO_SIGN_OUT":"வெளியேறு"}}}')},7552:function(e){e.exports=JSON.parse('{"te":{"com.amazon.dvweb.strings.accessibility":{"DV_WEB_DISMISS_BANNER":"బ్యానర్‌ను తీసివేయండి"},"com.amazon.dvweb.strings.deviceregistration":{"DV_WEB_DEVICE_REGISTRATION_BACK":"వెనక్కి వెళ్ళండి","DV_WEB_DEVICE_REGISTRATION_CODEPAIR_ERROR":"ప్రస్తుతం సైన్-ఇన్ కోడ్‌ను పొందలేకపోతున్నాము. దయచేసి తర్వాత మళ్లీ ప్రయత్నించండి.","DV_WEB_DEVICE_REGISTRATION_COUNTDOWN":"కోడ్ చెల్లుబాటు గడువు {time} ముగుస్తుంది","DV_WEB_DEVICE_REGISTRATION_EXPIRED_ERROR":"మీ సైన్-ఇన్ కోడ్ చెల్లుబాటు గడువు ముగిసింది.","DV_WEB_DEVICE_REGISTRATION_HEADING":"మీ ఫోన్‌తో సైన్ ఇన్ చేయండి","DV_WEB_DEVICE_REGISTRATION_INSTRUCTIONS":"QR కోడ్‌ను స్కాన్ చేయండి లేదా {url} విభాగానికి వెళ్లి, దిగువ కోడ్‌ను ఎంటర్ చేయండి.","DV_WEB_DEVICE_REGISTRATION_LOADING":"మీ సైన్-ఇన్ కోడ్‌ను పొందుతున్నాము…","DV_WEB_DEVICE_REGISTRATION_REGISTER_REJECTED":"మిమ్మల్ని సైన్ ఇన్ చేయలేకపోయాము. దయచేసి మళ్లీ ప్రయత్నించండి.","DV_WEB_DEVICE_REGISTRATION_RETRY":"కొత్త కోడ్‌ను పొందండి","DV_WEB_DEVICE_REGISTRATION_SUCCESS":"సైన్ ఇన్ చేస్తున్నాము…"},"com.amazon.dvweb.strings.downloads":{"DV_DP_ARIA_release_year":"{releaseYear}లో విడుదలైంది","DV_DP_ARIA_runtime":"నిడివి {runtime}","DV_DP_ARIA_suitable_for":"{ageGroup}కి తగినది","DV_TW_amr_nr_text":"రేట్ చేయబడలేదు.","DV_WEB_DOWNLOADS_MIGRATION_DOWNLOADED_HEADER":"డౌన్‌లోడ్ చేసిన వీడియోలు","DV_WEB_DOWNLOADS_MIGRATION_RESTORE":"పునరుద్ధరించు","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_DOWNLOAD":"డౌన్‌లోడ్‌ను పునరుద్ధరించండి","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_HEADER":"మీ డౌన్‌లోడ్ చేసిన వీడియోలను పునరుద్ధరించండి","DV_WEB_DOWNLOADS_MIGRATION_RESTORE_SUBHEADER":"ఈ యాప్‌లో చూసేందుకు మీ మునుపటి డౌన్‌లోడ్‌లను తప్పనిసరిగా మళ్లీ డౌన్‌లోడ్ చేయాలి.","DV_WEB_DOWNLOADS_NOT_SUPPORTED":"ఈ డివైజ్‌లో డౌన్‌లోడ్‌లకు సపోర్ట్ లేదు.","DV_WEB_DOWNLOADS_SEASON_EPISODE_TEMPLATE":"సీజన్ {seasonNumber} ఎపి {episodeNumber}","DV_WEB_OFFLINE_ERROR_DOWNLOADS_BUTTON":"డౌన్‌లోడ్‌ల పేజీకి వెళ్లండి","DV_WEB_OFFLINE_ERROR_HEADER":"మీ డివైజ్ ప్రస్తుతం ఆఫ్‌లైన్‌లో ఉంది.","DV_WEB_OFFLINE_ERROR_SUBHEADER_DOWNLOADS":"మీ వీడియోలను చూడటానికి డౌన్‌లోడ్‌లకు వెళ్లండి.","DV_WEB_OFFLINE_ERROR_SUBHEADER_NO_DOWNLOADS":"దయచేసి మీ డివైజ్ తిరిగి ఆన్‌లైన్‌లోకి వచ్చినప్పుడు, మళ్లీ ప్రయత్నించండి.","DV_WEB_download_pin_error_title":"డౌన్‌లోడ్ ఎర్రర్","DV_WEB_download_restriction_error_description":"మీ శీర్షికను డౌన్‌లోడ్ చేయడంలో మేము సమస్యను ఎదుర్కొంటున్నాము. దయచేసి మళ్లీ ప్రయత్నించండి. ఈ సమస్య కొనసాగితే, దయచేసి {link|contactUs}Amazon కస్టమర్ సర్వీస్‌{end}ను సంప్రదించి, దోషం 5015 అని తెలియజేయండి.","DV_WINAPP_ACTION_CANCELLED":"రద్దు చేయబడింది","DV_WINAPP_ACTION_CANCELLED_EPISODES":"రద్దు చేయబడింది {episodeText}","DV_WINAPP_ACTION_COMPLETED":"తొలగించండి","DV_WINAPP_ACTION_COMPLETED_EPISODES":"తొలగించండి {episodeText}","DV_WINAPP_ACTION_COMPLETED_SEASON":"సీజన్ {seasonNumber} డౌన్‌లోడ్ చేయబడింది","DV_WINAPP_ACTION_DOWNLOADING":"డౌన్​లోడ్ అవుతోంది","DV_WINAPP_ACTION_DOWNLOADING_EPISODES":"డౌన్​లోడ్ అవుతోంది {episodeText}","DV_WINAPP_ACTION_DOWNLOADING_SEASON":"{seasonNumber} సీజన్‌ను డౌన్‌లోడ్ చేస్తోంది","DV_WINAPP_ACTION_ERROR":"తప్పు","DV_WINAPP_ACTION_ERROR_EPISODES":"{episodeText} డౌన్‌లోడింగ్‌లో తప్పు","DV_WINAPP_ACTION_ERROR_SEASON":"సీజన్ {seasonNumber}లోని కొన్ని డౌన్‌లోడ్‌లు విఫలమయ్యాయి","DV_WINAPP_ACTION_IDLE":"డౌన్​లోడ్ చేయండి","DV_WINAPP_ACTION_IDLE_EPISODES":"డౌన్​లోడ్ {episodeText}","DV_WINAPP_ACTION_IDLE_SEASON":"{seasonNumber}వ సీజన్‌ను డౌన్‌లోడ్ చేసుకోండి","DV_WINAPP_ACTION_PAUSED":"పునఃప్రారంభించు","DV_WINAPP_ACTION_PAUSED_EPISODES":"పునఃప్రారంభించ {episodeText}ు","DV_WINAPP_ACTION_QUEUED":"క్యూలో ఉంది","DV_WINAPP_ACTION_QUEUED_EPISODES":"క్యూలో ఉంది {episodeText}","DV_WINAPP_ACTION_QUEUED_SEASON":"{seasonNumber}వ సీజన్ వరుసలో ఉంది","DV_WINAPP_ACTION_REMOVED":"తొలగించబడింది","DV_WINAPP_ACTION_REMOVED_EPISODES":"{episodeText} తొలగించబడింది","DV_WINAPP_ACTION_WAITING":"వేచి ఉంది","DV_WINAPP_BACKBUTTON":"వెనుకకు బటన్","DV_WINAPP_CANCEL_BUTTON":"రద్దు చేయండి","DV_WINAPP_DELETE_BUTTON":"తొలగించండి ({numItems})","DV_WINAPP_DESELECT_ALL":"అన్నింటి ఎంపికను తీసివేయి","DV_WINAPP_DOWNLOADS":"డౌన్​లోడ్​లు","DV_WINAPP_DOWNLOADS_AUDIO":"ఆడియో ట్రాక్స్","DV_WINAPP_DOWNLOADS_EMPTY_CTA":"డౌన్​లోడ్ చేయడానికి ఏదైనా కనుగొనండి","DV_WINAPP_DOWNLOADS_EMPTY_DESCRIPTION":"డౌన్‌లోడ్ చేసిన వీడియోలను ఎక్కడైనా వీక్షించవచ్చు మరియు ఇంటర్‌నెెట్ కనెక్షన్ అవసరం లేదు.","DV_WINAPP_DOWNLOADS_EMPTY_SUMMARY":"వీడియోలు ఏవీ ఇంకా డౌన్‌లోడ్ చేయబడలేదు...","DV_WINAPP_DOWNLOADS_QUALITY":"నాణ్యత: {Quality}","DV_WINAPP_DOWNLOADS_SEASON_TAB":"సీజన్ {seasonNumber}","DV_WINAPP_DOWNLOADS_SUBTITLES":"సబ్​టైటిల్స్","DV_WINAPP_DOWNLOAD_ERROR":"డౌన్‌లోడ్ ఎర్రర్","DV_WINAPP_DOWNLOAD_HIDE_EXTRA":"ఇతర డౌన్‌లోడ్‌లను దాచిపెట్టు","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_MESSAGE":"మీరు ఈ సబ్‌స్క్రిప్షన్ కోసం గరిష్ఠంగా సేవ్ చేయదగిన డౌన్‌లోడ్‌ల సంఖ్యను చేరుకున్నారు. దీన్ని డౌన్‌లోడ్ చేయడానికి, దయచేసి ఈ సబ్‌స్క్రిప్షన్ నుండి ఒక డౌన్‌లోడ్ చేసిన టైటిల్‌ని తొలగించి, ఆపై మళ్లీ ప్రయత్నించండి.","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_TITLE":"డౌన్‌లోడ్ పరిమితి మించిపోయింది","DV_WINAPP_DOWNLOAD_QUALITY":"డౌన్​లోడ్ నాణ్యత","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK":"ఎల్లప్పుడూ అడగాలి","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK_DESCRIPTION":"ప్రతి డౌన్‌లోడ్ కోసం డౌన్‌లోడ్ నాణ్యతను ఎంచుకోండి","DV_WINAPP_DOWNLOAD_QUALITY_BEST":"ఉత్తమమైన","DV_WINAPP_DOWNLOAD_QUALITY_BEST_DESCRIPTION":"1 గంట వీడియో దాదాపు 2.4 GB డేటా మరియు నిల్వని ఉపయోగిస్తుంది","DV_WINAPP_DOWNLOAD_QUALITY_BETTER":"మెరుగైన","DV_WINAPP_DOWNLOAD_QUALITY_BETTER_DESCRIPTION":"1 గంట వీడియో దాదాపు 1.1 GB డేటా మరియు నిల్వని ఉపయోగిస్తుంది.","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER":"డేటా సేవర్","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER_DESCRIPTION":"1 గంట వీడియో దాదాపు 0.3 GB డేటా మరియు నిల్వని ఉపయోగిస్తుంది","DV_WINAPP_DOWNLOAD_QUALITY_GOOD":"బాగుంది","DV_WINAPP_DOWNLOAD_QUALITY_GOOD_DESCRIPTION":"1 గంట వీడియో దాదాపు 0.5 GB డేటా మరియు నిల్వని ఉపయోగిస్తుంది","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ADDITIONAL_LANG_INFO":"అదనపు భాషలను మీ డౌన్‌లోడ్‌లలో జోడించవచ్చు.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DEFAULT_LANG_MISSING":"{displayName} అందుబాటులో లేదు.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DOWNLOAD_BUTTON_LABEL":"డౌన్‌లోడ్‌ని ప్రారంభించు","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_MESSAGE":"డౌన్‌లోడ్‌ల పేజీలో ఎప్పుడైనా డౌన్‌లోడ్ ఎంపికలను నిర్వహించండి.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_ADDITIONAL_LANG":"అదనపు భాష లేదు","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_AUDIO_LANG":"డౌన్‌లోడ్ చేయాల్సిన ఆడియో భాషను ఎంచుకోండి.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_OPTIONS_AUDIO":"ఆడియో భాషలు","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_AVAILABLE":"{displayName} డిఫాల్ట్‌గా డౌన్‌లోడ్ అవుతుంది.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_MISSING":"ఈ వీడియో కోసం అసలు భాష అందుబాటులో లేదు.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_SET_DEFAULT":"డిఫాల్ట్‌గా సెట్ చేయండి","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_TITLE":"{title} కోసం డౌన్‌లోడ్ ఎంపికలు","DV_WINAPP_DOWNLOAD_SETTINGS_RESET":"అదనపు ఆడియో భాషను డౌన్‌లోడ్ చేయండి","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_BUTTON":"భాష ఎంపికను రీసెట్ చేయండి","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_LABEL":"ఇంకా సెట్ చేయలేదు","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_MESSAGE":"మేము వీడియో ఒరిజినల్ ఆడియో భాషను ఆటోమేటిక్‌గా డౌన్‌లోడ్ చేస్తాము. మీరు అదనపు ప్రాధాన్య భాష (అందుబాటులో ఉంటే) డౌన్‌లోడ్ చేసే విధంగా ఎంచుకుని, దాన్ని డౌన్‌లోడ్ విండోలో డిఫాల్ట్‌గా సెట్ చేయవచ్చు. మీ ప్రాధాన్యత ఇక్కడ కనిపిస్తుంది.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MESSAGE":"మేము వీడియో ఒరిజినల్ ఆడియో భాషను డౌన్‌లోడ్ చేసి, దాంతో పాటు మీరు కోరుకునే అదనపు ప్రాధాన్య భాష (ఒకవేళ అందుబాటులో ఉంటే), అది కూడా డౌన్‌లోడ్ చేస్తాము.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_DISMISS_BUTTON":"రద్దు చేయండి","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_MESSAGE":"మీరు వీడియోను డౌన్‌లోడ్ చేసే తర్వాతిసారి, ప్రాధాన్య అదనపు ఎంచుకోవాల్సిందిగా మిమ్మల్ని అడుగుతాము.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_RESET_BUTTON":"సరే","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_TITLE":"మీరు ఖచ్చితంగా రీసెట్ చేయాలనుకుంటున్నారా?","DV_WINAPP_DOWNLOAD_SHOW_EXTRA":"ఇతర డౌన్​లోడ్‌లును చూపించు","DV_WINAPP_DROPLIST_CANCELDL":"డౌన్​లోడ్ రద్దు చేయండి","DV_WINAPP_DROPLIST_DELETEDL":"డౌన్‌లోడ్‌ను తొలగించండి","DV_WINAPP_DROPLIST_ERROR":"ఎర్రర్ వివరాలను చూడండి","DV_WINAPP_DROPLIST_PAUSEDL":"డౌన్​లోడ్​ను పాజ్ చేయండి","DV_WINAPP_DROPLIST_PLAY":"ప్లే చేయి","DV_WINAPP_DROPLIST_RESUMEDL":"డౌన్‌లోడ్‌ను పునఃప్రారంభించండి","DV_WINAPP_DROPLIST_RETRYDL":"డౌన్‌లోడ్‌ను మళ్లీ ప్రయత్నించండి","DV_WINAPP_DROPLIST_STARTDL":"డౌన్​లోడ్​ను ప్రారంభించండి","DV_WINAPP_DROPLIST_VIEWDETAIL":"వివరాలు చూడండి","DV_WINAPP_DURATION":"{hours}గం {minutes}నిమి","DV_WINAPP_EDIT_BUTTON":"సవరించండి","DV_WINAPP_EPISODE_BONUS":"బోనస్ ఎపిసోడ్","DV_WINAPP_EPISODE_NB":"ఎపిసోడ్ {episodeNumber}","DV_WINAPP_FIND_MORE_EPISODES":"మరిన్ని ఎపిసోడ్‌లను కనుగొనండి","DV_WINAPP_GENERIC_ERROR_MESSAGE":"దయచేసి కొద్ది నిమిషాల తర్వాత మీ అభ్యర్థనను మళ్లీ ప్రయత్నించండి లేదా {brand} కస్టమర్ సర్వీస్‌ను {contactUsUrl} ద్వారా సంప్రదించండి.","DV_WINAPP_GENERIC_ERROR_TITLE":"సమస్య ఏర్పడింది","DV_WINAPP_GENERIC_PLAYBACK_ERROR_MESSAGE":"మీ వీడియోను ఇప్పుడు మేము ప్లే చేయలేము. దయచేసి కొద్ది నిమిషాల్లో మళ్లీ ప్రయత్నించండి. సమస్య కొనసాగుతుంటే, దయచేసి {brand} కస్టమర్ సర్వీస్‌ను {contactUsUrl} ద్వారా సంప్రదించండి.","DV_WINAPP_GENERIC_PLAYBACK_ERROR_TITLE":"వీడియో అందుబాటులో లేదు","DV_WINAPP_HAMBURGER":"మెను","DV_WINAPP_INVALID_GEO_IP_ERROR_MESSAGE":"భౌగోళిక లైసెన్సింగ్ నియంత్రణల కారణంగా ఈ వీడియోను డౌన్‌లోడ్ చేయడం అనుమతించబడదు. మరిన్ని వివరాల కోసం, దయచేసి {brand} వినియోగ నిబంధనలు చూడండి. మరింత సహాయం కోసం, {brand} కస్టమర్ సర్వీస్‌ను {contactUsUrl} ద్వారా సంప్రదించండి.","DV_WINAPP_INVALID_GEO_IP_ERROR_TITLE":"సర్వీస్ ఏరియా నియంత్రణ","DV_WINAPP_LICENSE_EXPIRED_ERROR_MESSAGE":"ఈ వీడియోను ఆఫ్‌లైన్లో చూసే గడువు ముగిసింది. ఆఫ్‌లైన్ వీక్షణను తిరిగి-ప్రారంభించేందుకు దయచేసి మీ పరికరాన్ని ఇంటర్నెట్టుకు కనెక్ట్ చేసి వీడియోను ప్లే చేయండి.","DV_WINAPP_LICENSE_EXPIRED_ERROR_TITLE":"ఆఫ్‌లైన్ వీక్షణ గడువు ముగిసింది","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_MESSAGE":"అందుబాటులో లేని భాషలు: {missingTracks}","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_TITLE":"అదనపు భాషలు అందుబాటులో లేవు","DV_WINAPP_NAV_BACK_BUTTON":"వెనుకకు","DV_WINAPP_NAV_HIDE_BUTTON":"దాచు","DV_WINAPP_OFFLINE_DESC":"మీ డివైజ్ ఆఫ్‌లైన్‌లో ఉన్నప్పుడు వీడియోలను చూడటానికి {link|/spa/downloads}డౌన్‌లోడ్‌లు{end} కు వెళ్లండి.","DV_WINAPP_OFFLINE_HEADING":"మీ డివైజ్ ప్రస్తుతం ఆఫ్‌లైన్‌లో ఉంది","DV_WINAPP_OUT_OF_SPACE_ERROR_MESSAGE":"మీ డివైజ్‌లో నిల్వ స్థలం తక్కువ ఉన్నందున మేము మీ వీడియోను డౌన్‌లోడ్ చేయలేము. మీకు ఇకపై అవసరం లేని అంశాలు లేదా యాప్‌లను తొలగించి, ఆపై మళ్లీ ప్రయత్నంచండి.","DV_WINAPP_OUT_OF_SPACE_ERROR_TITLE":"తగినంత స్పేస్ లేదు","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_MESSAGE":"ఈ వీడియో చూడటానికి అందుబాటులో లేదు.","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_TITLE":"వీడియో అందుబాటులో లేదు","DV_WINAPP_PLAYMODAL_CANCEL":"రద్దు చేయండి","DV_WINAPP_PLAYMODAL_CTA":"ఇప్పుడే చూడండి","DV_WINAPP_PLAYMODAL_HEAD":"{hours}గం ఆఫ్‌లైన్ వీక్షణ వ్యవధిని ప్రారంభించండి","DV_WINAPP_PLAYRENTALMODAL_DESC":"మీరు ఈ వీడియో కోసం {hours} గంటల అద్దె వ్యవధిని ప్రారంభిస్తున్నారు.","DV_WINAPP_PLAYRENTALMODAL_SUBDESC":"గమనిక: ఈ వీడియోను కేవలం ఒక డివైజ్‌కు మాత్రమే డౌన్‌లోడ్ చేయగలరు, కానీ సపోర్ట్ ఉన్న ఏదైనా డివైజ్ నుండి ఆన్‌లైన్‌లో చూడవచ్చు.","DV_WINAPP_SELECT_ALL":"అన్నీ ఎంపిక చేయి","DV_WINAPP_SETTINGS":"సెట్టింగ్​లు","DV_WINAPP_SETTINGS_DOWNLOADS":"Prime Video డౌన్​లోడ్​లు","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_MESSAGE":"మీరు కొనసాగే ముందు {brand} వినియోగ నిబంధనలకు తప్పక అంగీకరించాలి.","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_TITLE":"నిబంధనలకు అంగీకరించలేదు"},"com.amazon.dvweb.strings.mxplayer":{"DV_WEB_MX_DATA_SYNC_FALLBACK":"MX Player నుండి మీ కంటెంట్ సింక్ కాలేదు. దయచేసి పేజీని రిఫ్రెష్ చేసి మళ్లీ ప్రయత్నించండి.","DV_WEB_MX_REDIRECT_BODY":"మేము మీ డేటాను సింక్ చేస్తున్నందున, దయచేసి వేచి ఉండండి.","DV_WEB_MX_REDIRECT_HEADER":"Amazon MX Player ఇప్పుడు Prime Video అయింది."},"com.amazon.dvweb.strings.server":{"DV_WEB_brand_pv":"Prime Video"},"com.amazon.dvweb.strings.xdsso":{"DV_WEB_XDSSO_BANNER_TEXT":"మీరు Amazon ద్వారా {name} పేరుతో సైన్ ఇన్ చేసారు. మీరు కాదా?","DV_WEB_XDSSO_LOCKED_PROFILE_BANNER_TEXT":"మీరు Amazon ద్వారా సైన్ ఇన్ చేసారు. ఇప్పుడు కాదా?","DV_WEB_XDSSO_SIGN_OUT":"సైన్ అవుట్ చేయండి"}}}')},71680:function(e){e.exports=JSON.parse('{"th":{"com.amazon.dvweb.strings.accessibility":{"DV_WEB_DISMISS_BANNER":"ปิดแบนเนอร์"},"com.amazon.dvweb.strings.deviceregistration":{"DV_WEB_DEVICE_REGISTRATION_BACK":"ย้อนกลับ","DV_WEB_DEVICE_REGISTRATION_CODEPAIR_ERROR":"ขณะนี้ไม่สามารถรับรหัสลงชื่อเข้าใช้ได้ โปรดลองอีกครั้ง","DV_WEB_DEVICE_REGISTRATION_COUNTDOWN":"รหัสจะหมดอายุใน {time}","DV_WEB_DEVICE_REGISTRATION_EXPIRED_ERROR":"รหัสลงชื่อเข้าใช้หมดอายุแล้ว","DV_WEB_DEVICE_REGISTRATION_HEADING":"ลงชื่อเข้าใช้ด้วยโทรศัพท์ของคุณ","DV_WEB_DEVICE_REGISTRATION_INSTRUCTIONS":"สแกนรหัส QR หรือไปที่ {url} และป้อนรหัสด้านล่าง","DV_WEB_DEVICE_REGISTRATION_LOADING":"กำลังรับรหัสลงชื่อเข้าใช้…","DV_WEB_DEVICE_REGISTRATION_REGISTER_REJECTED":"ลงชื่อเข้าใช้ไม่สำเร็จ โปรดลองอีกครั้ง","DV_WEB_DEVICE_REGISTRATION_RETRY":"รับรหัสใหม่","DV_WEB_DEVICE_REGISTRATION_SUCCESS":"กำลังลงชื่อเข้าใช้…"},"com.amazon.dvweb