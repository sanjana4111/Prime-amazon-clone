# $isFirstLoad - true for a page load, returning the tab list plus the first group's tiles; false for a
#                tab change, returning one group by id. \`entities\` arguments apply to every group in a
#                \`favoriteGroups\` selection, so the first group's tiles need their own aliased call.
# $groupId     - which group to return when $isFirstLoad is false. Defaulted because
#                \`favoriteGroup(id:)\` is non-null and both modes share one document; never resolved on
#                first load, and not a valid id, so a caller that omits it gets null rather than a group.
# $first       - entities per group. The gateway caps it at 20 and defaults to 20 when omitted.
# $after       - entity cursor, for the next page of a group holding more than $first entities.
query FavoriteGroupsDiscoveryPage($isFirstLoad: Boolean!, $groupId: ID! = "unused-on-first-load", $first: Int, $after: String) {
    tabs: favoriteGroups(domain: SPORTS) @include(if: $isFirstLoad) {
        groups {
            id
            title
            image {
                url
            }
        }
        pageInfo {
            hasNextPage
            endCursor
        }
    }

    firstGroup: favoriteGroups(domain: SPORTS, first: 1) @include(if: $isFirstLoad) {
        groups {
            ...GroupWithEntities
        }
    }

    selectedGroup: favoriteGroup(id: $groupId, domain: SPORTS) @skip(if: $isFirstLoad) {
        ...GroupWithEntities
    }
}

fragment GroupWithEntities on FavoriteGroup {
    __typename
    id
    title
    ... on SportsFavoriteGroup {
        entities(first: $first, after: $after) {
            sportEntities {
                ...FavoritableGroupEntity
            }
            pageInfo {
                nextCursor
                hasNextPage
            }
        }
    }
}

fragment FavoritableGroupEntity on SportsEntity {
    __typename
    id
    ... on GenericSportsOrganization {
        name
        displayName
        logo {
            url
        }
        orgColors: colors {
            type
            rgb {
                red
                green
                blue
            }
        }
        icidTitle {
            ...GroupFavoriteState
        }
    }
    ... on GenericCompetitorGroup {
        name
        displayName
        logo {
            url
        }
        teamColors: colors {
            primary {
                red
                green
                blue
            }
        }
        icidTitle {
            ...GroupFavoriteState
        }
    }
}

fragment GroupFavoriteState on IcidTitle {
    icid
    feedback(request: { version: 1 }) {
        __typename
        ... on AFeedbackV1Output {
            shouldShowFeedbacks
            feedbacks {
                type
                isSelected
            }
        }
