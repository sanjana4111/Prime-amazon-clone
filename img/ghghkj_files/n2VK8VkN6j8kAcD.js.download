    (function () {
        window.DVWebNode = window.DVWebNode || {};
        // Only pointerdown carries the device; click does not, outside Chromium. Recorded for play buttons alone
        // and consumed by the next click, so a keyboard activation inherits nothing.
        var pointerType;
        var playButtonOf = function (t) { return t && t.closest ? t.closest('[data-pv-play-key]') : null; };
        var choiceOf = function (t) { return t && t.closest ? t.closest('[data-pv-play-choice]') : null; };
        document.addEventListener('pointerdown', function (e) { pointerType = playButtonOf(e.target) ? e.pointerType : undefined; }, true);
        document.addEventListener('pointercancel', function () { pointerType = undefined; }, true);
        // The page must not scroll behind the open pre-mount dialog, as it does not behind Fable's drawer.
        var lockScroll = function (on) { document.documentElement.classList[on ? 'add' : 'remove']('fable-no-scroll'); };
        var clearPressed = function () {
            var marked = document.querySelectorAll('.dv-dp-node-playback-pressed, .dv-dp-node-playback-dialog');
            for (var i = 0; i < marked.length; i++) marked[i].classList.remove('dv-dp-node-playback-pressed', 'dv-dp-node-playback-dialog', 'dv-dp-node-playback-dialog-loading');
            lockScroll(false);
        };
        var store = {
            pending: undefined,
            clearPressed: clearPressed,
            take: function (key) {
                var c = store.pending;
                if (!c || c.key !== key) return undefined;
                store.pending = undefined;
                clearPressed();
                return { pointerType: c.pointerType, time: c.time, choice: c.choice };
            }
        };
        DVWebNode.preMountPlayClick = store;
        document.addEventListener('click', function (e) {
            var devicePointerType = pointerType;
            pointerType = undefined;
            // Once hydrated, usePlayButtonStatus owns the click.
            if (DVWebNode.mounted) return;
            var el = playButtonOf(e.target);
            if (!el) return;
            var key = el.getAttribute('data-pv-play-key');
            if (!key) return;
            var choiceEl = choiceOf(e.target);
            // A tap inside this host's open pre-mount dialog answers the press instead of replacing it.
            if (choiceEl) {
                var c = store.pending;
                if (!c || c.key !== key) return;
                c.choice = choiceEl.getAttribute('data-pv-play-choice');
                // The app link is a plain anchor: the browser deeplinks on its own.
                if (c.choice === 'app') return;
                e.preventDefault();
                if (c.choice === 'here') { el.classList.add('dv-dp-node-playback-dialog-loading'); return; }
                el.classList.remove('dv-dp-node-playback-dialog', 'dv-dp-node-playback-dialog-loading');
                lockScroll(false);
                return;
            }
            // Anywhere else on the open pre-mount dialog answers nothing and must not re-register the press.
            if (el.classList.contains('dv-dp-node-playback-dialog')) { e.preventDefault(); return; }
            // Leave open-in-new-tab to the browser; middle click fires auxclick, not click.
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            // Last click wins, as the hook's page-wide intent does.
            clearPressed();
            var kind = el.hasAttribute('data-pv-play-dialog') ? 'dialog' : 'play';
            el.classList.add(kind === 'dialog' ? 'dv-dp-node-playback-dialog' : 'dv-dp-node-playback-pressed');
            if (kind === 'dialog') lockScroll(true);
