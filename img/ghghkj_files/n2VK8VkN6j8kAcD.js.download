िए डाउनलोड पर जाएं.","DV_WEB_OFFLINE_ERROR_SUBHEADER_NO_DOWNLOADS":"जब आपका डिवाइस वापस ऑनलाइन हो, तो कृपया फिर से कोशिश करें.","DV_WEB_download_pin_error_title":"डाउनलोड एरर","DV_WEB_download_restriction_error_description":"हमें आपका टाइटल डाउनलोड करने में समस्या आ रही है. कृपया फिर से कोशिश करें. अगर यह समस्या जारी रहती है, तो कृपया {link|contactUs}Amazon ग्राहक सेवा से संपर्क करें{end} और एरर 5015 के बारे में बताएं.","DV_WINAPP_ACTION_CANCELLED":"कैंसल किया गया","DV_WINAPP_ACTION_CANCELLED_EPISODES":"कैंसल किया गया {episodeText}","DV_WINAPP_ACTION_COMPLETED":"डिलीट करें","DV_WINAPP_ACTION_COMPLETED_EPISODES":"{episodeText} डिलीट करें","DV_WINAPP_ACTION_COMPLETED_SEASON":"{seasonNumber} सीज़न डाउनलोड किया गया","DV_WINAPP_ACTION_DOWNLOADING":"डाउनलोड हो रहा है","DV_WINAPP_ACTION_DOWNLOADING_EPISODES":"{episodeText} डाउनलोड हो रहा है","DV_WINAPP_ACTION_DOWNLOADING_SEASON":"सीज़न {seasonNumber} डाउनलोड हो रहा है","DV_WINAPP_ACTION_ERROR":"एरर","DV_WINAPP_ACTION_ERROR_EPISODES":"{episodeText} डाउनलोड करने में त्रुटि","DV_WINAPP_ACTION_ERROR_SEASON":"कुछ सीज़न {seasonNumber} डाउनलोड नहीं हो पाए","DV_WINAPP_ACTION_IDLE":"डाउनलोड करें","DV_WINAPP_ACTION_IDLE_EPISODES":"डाउनलोड करें {episodeText}","DV_WINAPP_ACTION_IDLE_SEASON":"सीज़न {seasonNumber} डाउनलोड करें","DV_WINAPP_ACTION_PAUSED":"फिर से शुरू करें","DV_WINAPP_ACTION_PAUSED_EPISODES":"{episodeText} फिर से शुरू करें","DV_WINAPP_ACTION_QUEUED":"कतार में","DV_WINAPP_ACTION_QUEUED_EPISODES":"{episodeText} कतार में","DV_WINAPP_ACTION_QUEUED_SEASON":"कतार में रखा गया सीज़न {seasonNumber}","DV_WINAPP_ACTION_REMOVED":"हटा दिया गया","DV_WINAPP_ACTION_REMOVED_EPISODES":"{episodeText}हटा दिया गया.","DV_WINAPP_ACTION_WAITING":"प्रतीक्षा में","DV_WINAPP_BACKBUTTON":"पीछे जाने का बटन","DV_WINAPP_CANCEL_BUTTON":"कैंसल करें","DV_WINAPP_DELETE_BUTTON":"({numItems}) डिलीट करें","DV_WINAPP_DESELECT_ALL":"सभी चयन हटाएं","DV_WINAPP_DOWNLOADS":"डाउनलोड","DV_WINAPP_DOWNLOADS_AUDIO":"ऑडियो ट्रैक","DV_WINAPP_DOWNLOADS_EMPTY_CTA":"डाउनलोड करने के लिए कुछ खोजें","DV_WINAPP_DOWNLOADS_EMPTY_DESCRIPTION":"डाउनलोड किए गए वीडियो कहीं भी देखे जा सकते हैं और इंटरनेट कनेक्शन की आवश्यकता नहीं है.","DV_WINAPP_DOWNLOADS_EMPTY_SUMMARY":"अभी तक कोई वीडियो डाउनलोड नहीं किया गया...","DV_WINAPP_DOWNLOADS_QUALITY":"क्वालिटी: {Quality}","DV_WINAPP_DOWNLOADS_SEASON_TAB":"सीज़न {seasonNumber}","DV_WINAPP_DOWNLOADS_SUBTITLES":"सबटाइटल","DV_WINAPP_DOWNLOAD_ERROR":"डाउनलोड एरर","DV_WINAPP_DOWNLOAD_HIDE_EXTRA":"अन्य डाउनलोड छिपाएं","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_MESSAGE":"आप इस सब्सक्रिप्शन के लिए मौजूद अधिकतम सेव किए गए डाउनलोड की संख्या पर हैं. डाउनलोड करने के लिए, कृपया इस सब्सक्रिप्शन से डाउनलोड किया गया टाइटल हटा दें, और फिर दोबारा कोशिश करें.","DV_WINAPP_DOWNLOAD_LIMIT_EXCEEDED_ERROR_TITLE":"डाउनलोड सीमा पार हो चुकी है","DV_WINAPP_DOWNLOAD_QUALITY":"डाउनलोड क्वालिटी","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK":"हमेशा पूछें","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK_DESCRIPTION":"हर डाउनलोड के लिए डाउनलोड गुणवत्ता चुनें","DV_WINAPP_DOWNLOAD_QUALITY_BEST":"सर्वश्रेष्ठ","DV_WINAPP_DOWNLOAD_QUALITY_BEST_DESCRIPTION":"1 घंटे के वीडियो में लगभग 2.4 GB डेटा स्‍टोरेज का उपयोग होता है","DV_WINAPP_DOWNLOAD_QUALITY_BETTER":"बेहतर","DV_WINAPP_DOWNLOAD_QUALITY_BETTER_DESCRIPTION":"1 घंटे के वीडियो में लगभग 1.1 GB डेटा स्‍टोरेज का उपयोग होता है","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER":"डेटा सेवर","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER_DESCRIPTION":"1 घंटे का वीडियो करीब 0.3 जीबी डेटा और स्टोरेज इस्तेमाल करता है","DV_WINAPP_DOWNLOAD_QUALITY_GOOD":"बढ़िया","DV_WINAPP_DOWNLOAD_QUALITY_GOOD_DESCRIPTION":"1 घंटे के वीडियो में लगभग 0.5 GB डेटा स्‍टोरेज का उपयोग होता है","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ADDITIONAL_LANG_INFO":"अतिरिक्त भाषाओं को आपके डाउनलोड के साथ शामिल किया जा सकता है.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DEFAULT_LANG_MISSING":"{displayName} अनुपलब्ध है.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DOWNLOAD_BUTTON_LABEL":"डाउनलोड शुरू करें","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_MESSAGE":"डाउनलोड पेज पर कभी भी डाउनलोड विकल्प मैनेज करें.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_ADDITIONAL_LANG":"कोई अतिरिक्त भाषा नहीं","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_AUDIO_LANG":"डाउनलोड करने के लिए ऑडियो की एक भाषा चुनें.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_OPTIONS_AUDIO":"ऑडियो की भाषाएं","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_AVAILABLE":"{displayName} डिफ़ॉल्ट रूप से डाउनलोड किया जाएगा.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_MISSING":"इस वीडियो के लिए मूल भाषा उपलब्ध नहीं है.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_SET_DEFAULT":"डिफ़ॉल्ट के रूप में सेट करें","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_TITLE":"{title} के लिए विकल्प डाउनलोड करें","DV_WINAPP_DOWNLOAD_SETTINGS_RESET":"अतिरिक्त ऑडियो भाषा डाउनलोड करें","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_BUTTON":"भाषा चयन रीसेट करें","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_LABEL":"अभी तक सेट नहीं है","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_MESSAGE":"हम अपने आप वीडियो की मूल ऑडियो भाषा डाउनलोड करते हैं. आप एक अतिरिक्त पसंदीदा भाषा (उपलब्ध होने पर) डाउनलोड करना चुन सकते हैं और इसे डाउनलोड विंडो में डिफ़ॉल्ट के रूप में सेट कर सकते हैं. आपकी वरीयता यहां दिखाई देती है.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MESSAGE":"हम वीडियो की मूल ऑडियो भाषा और आपकी अतिरिक्त पसंदीदा भाषा (उपलब्ध होने पर) डाउनलोड करेंगे.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_DISMISS_BUTTON":"कैंसल करें","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_MESSAGE":"अगली बार जब आप वीडियो डाउनलोड करेंगे, तो हम आपसे एक अतिरिक्त पसंदीदा भाषा चुनने के लिए कहेंगे.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_RESET_BUTTON":"ठीक","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_TITLE":"क्या आप वाकई रीसेट करना चाहते हैं?","DV_WINAPP_DOWNLOAD_SHOW_EXTRA":"अन्य डाउनलोड दिखाएं","DV_WINAPP_DROPLIST_CANCELDL":"डाउनलोड कैंसल करें","DV_WINAPP_DROPLIST_DELETEDL":"डाउनलोड हटाएं","DV_WINAPP_DROPLIST_ERROR":"एरर का विवरण देखें","DV_WINAPP_DROPLIST_PAUSEDL":"डाउनलोड रोकें","DV_WINAPP_DROPLIST_PLAY":"प्ले करें","DV_WINAPP_DROPLIST_RESUMEDL":"डाउनलोड फिर से शुरू करें","DV_WINAPP_DROPLIST_RETRYDL":"फिर से डाउनलोड की कोशिश करें","DV