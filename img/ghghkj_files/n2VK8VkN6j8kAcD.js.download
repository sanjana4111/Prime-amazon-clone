ل","DV_WINAPP_DOWNLOAD_QUALITY":"جودة التحميل","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK":"السؤال دائمًا","DV_WINAPP_DOWNLOAD_QUALITY_ALWAYS_ASK_DESCRIPTION":"حدد جودة التحميل لكل تحميل","DV_WINAPP_DOWNLOAD_QUALITY_BEST":"فائقة","DV_WINAPP_DOWNLOAD_QUALITY_BEST_DESCRIPTION":"تستلزم ساعة واحدة من الفيديو حوالي 2.4 غيغابايت من بيانات الإنترنت وسعة التخزين","DV_WINAPP_DOWNLOAD_QUALITY_BETTER":"ممتازة","DV_WINAPP_DOWNLOAD_QUALITY_BETTER_DESCRIPTION":"تستلزم ساعة واحدة من الفيديو حوالي 1.1 غيغابايت من بيانات الإنترنت وسعة التخزين","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER":"توفير البيانات","DV_WINAPP_DOWNLOAD_QUALITY_DATA_SAVER_DESCRIPTION":"تستلزم ساعة واحدة من الفيديو حوالي 0.3 غيغابايت من بيانات الإنترنت وسعة التخزين","DV_WINAPP_DOWNLOAD_QUALITY_GOOD":"جيدة","DV_WINAPP_DOWNLOAD_QUALITY_GOOD_DESCRIPTION":"تستلزم ساعة واحدة من الفيديو حوالي 0.5 غيغابايت من بيانات الإنترنت وسعة التخزين","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ADDITIONAL_LANG_INFO":"يمكن إضافة لغات إضافية في التحميل.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DEFAULT_LANG_MISSING":"{displayName} غير متوفر.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_DOWNLOAD_BUTTON_LABEL":"بدء التحميل","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_MESSAGE":"يمكنك إدارة خيارات التحميل في أي وقت على صفحة التحميلات.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_ADDITIONAL_LANG":"لا توجد لغة إضافية","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_NO_AUDIO_LANG":"اختر لغة صوت للتحميل.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_OPTIONS_AUDIO":"لغات الصوت","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_AVAILABLE":"سيتم تحميل {displayName} تلقائيًا.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_ORIGINAL_LANG_MISSING":"اللغة الأصلية غير متوفرة لهذا الفيديو.","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_SET_DEFAULT":"تعيين كخيار تلقائي","DV_WINAPP_DOWNLOAD_SETTINGS_MODAL_TITLE":"خيارات التحميل لـ {title}","DV_WINAPP_DOWNLOAD_SETTINGS_RESET":"تحميل لغة صوت إضافية","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_BUTTON":"إعادة تعيين اختيار اللغة","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_LABEL":"لم تحدد بعد","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_DEFAULT_MESSAGE":"نقوم تلقائيًا بتحميل لغة الصوت الأصلية للفيديو. يمكنك اختيار تحميل لغة مفضلة إضافية (عند توفرها) وتعيينها كلغة افتراضية في نافذة التحميل. يظهر تفضيلك هنا.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MESSAGE":"سنقوم بتحميل لغة الصوت الأصلية للفيديو ولغتك المفضلة الإضافية (عند توفرها).","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_DISMISS_BUTTON":"إلغاء","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_MESSAGE":"في المرة التالية التي تقوم فيها بتحميل مقطع فيديو، سنطلب منك اختيار لغة إضافية مفضلة.","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_RESET_BUTTON":"موافق","DV_WINAPP_DOWNLOAD_SETTINGS_RESET_MODAL_TITLE":"هل تريد بالتأكيد إعادة التعيين؟","DV_WINAPP_DOWNLOAD_SHOW_EXTRA":"عرض التحميلات الأخرى","DV_WINAPP_DROPLIST_CANCELDL":"إلغاء التحميل","DV_WINAPP_DROPLIST_DELETEDL":"حذف التحميل","DV_WINAPP_DROPLIST_ERROR":"عرض تفاصيل الخطأ","DV_WINAPP_DROPLIST_PAUSEDL":"إيقاف التحميل مؤقتًا","DV_WINAPP_DROPLIST_PLAY":"عرض","DV_WINAPP_DROPLIST_RESUMEDL":"استئناف التحميل","DV_WINAPP_DROPLIST_RETRYDL":"إعادة محاولة التحميل","DV_WINAPP_DROPLIST_STARTDL":"بدء التحميل","DV_WINAPP_DROPLIST_VIEWDETAIL":"عرض التفاصيل","DV_WINAPP_DURATION":"{hours} ساعة {minutes} دقيقة","DV_WINAPP_EDIT_BUTTON":"تحرير","DV_WINAPP_EPISODE_BONUS":"حلقة إضافية","DV_WINAPP_EPISODE_NB":"الحلقة {episodeNumber}","DV_WINAPP_FIND_MORE_EPISODES":"البحث عن المزيد من الحلقات","DV_WINAPP_GENERIC_ERROR_MESSAGE":"يرجى محاولة طلبك مرة أخرى في بضع دقائق أو الاتصال بخدمة عملاء {brand} على {contactUsUrl}.","DV_WINAPP_GENERIC_ERROR_TITLE":"حدثت مشكلة","DV_WINAPP_GENERIC_PLAYBACK_ERROR_MESSAGE":"يتعذر علينا على تشغيل الفيديو الآن. يرجى المحاولة مرة أخرى خلال بضع دقائق. إذا استمرت المشكلة، يرجى الاتصال بخدمة عملاء {brand} على {contactUsUrl}.","DV_WINAPP_GENERIC_PLAYBACK_ERROR_TITLE":"الفيديو غير متاح","DV_WINAPP_HAMBURGER":"القائمة","DV_WINAPP_INVALID_GEO_IP_ERROR_MESSAGE":"هذا الفيديو غير متاح للتحميل بسبب قيود الترخيص الجغرافي. لمزيد من التفاصيل، يرجى الرجوع إلى شروط الاستخدام لدى {brand}. للحصول على مزيد من المساعدة، يرجى الاتصال بخدمة عملاء {brand} على {contactUsUrl}.","DV_WINAPP_INVALID_GEO_IP_ERROR_TITLE":"تقييد منطقة الخدمة","DV_WINAPP_LICENSE_EXPIRED_ERROR_MESSAGE":"انتهت صلاحية إمكانية مشاهدة هذا الفيديو بدون اتصال بالإنترنت. يرجى توصيل جهازك بالإنترنت ثم تشغيل الفيديو لإعادة تمكين المشاهدة بدون الاتصال بالإنترنت.","DV_WINAPP_LICENSE_EXPIRED_ERROR_TITLE":"انتهت صلاحية إمكانية المشاهدة بدون اتصال بالإنترنت","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_MESSAGE":"اللغات غير المتوقرة: {missingTracks}","DV_WINAPP_MANIFEST_MISSING_TRACK_WARNING_TITLE":"اللغات الإضافية غير متوفرة","DV_WINAPP_NAV_BACK_BUTTON":"رجوع","DV_WINAPP_NAV_HIDE_BUTTON":"إخفاء","DV_WINAPP_OFFLINE_DESC":"انتقل إلى {link|/spa/downloads}التحميلات{end} لمشاهدة مقاطع الفيديو أثناء عدم اتصال جهازك بالإنترنت.","DV_WINAPP_OFFLINE_HEADING":"جهازك غير متصل بالإنترنت حاليًا","DV_WINAPP_OUT_OF_SPACE_ERROR_MESSAGE":"يتعذر علينا تحميل الفيديو نظرًا لعدم وجود مساحة تخزين كافية في جهازك. يرجى حذف العناصر أو التطبيقات التي لم تعد تريدها، ثم المحاولة مرة أخرى.","DV_WINAPP_OUT_OF_SPACE_ERROR_TITLE":"لا توجد مساحة كافية","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_MESSAGE":"هذا الفيديو غير متوفر للمشاهدة.","DV_WINAPP_OWNERSHIP_EXCEPTION_ERROR_TITLE":"الفيديو غير متاح","DV_WINAPP_PLAYMODAL_CANCEL":"إلغاء","DV_WINAPP_PLAYMODAL_CTA":"شاهد الآن","DV_WINAPP_PLAYMODAL_HEAD":"بدء فترة إمكانية المشاهدة بدون اتصال بالإنترنت لمدة {hours} ساعة","DV_WINAPP_PLAYRENTALMODAL_DESC":"أنت على وشك بدء فترة الإيجار لمدة {hours} ساعة لهذا الفيديو.","DV_WINAPP_PLAYRENTALMODAL_SUBDESC":"ملاحظة: يمكن تنزيل هذا الفيديو على جهاز واحد فقط، ولكن يمكن مشاهدته عبر الإنترنت من أي جهاز مدعوم.","DV_WINAPP_SELECT_ALL":"تحديد الكل","DV_WINAPP_SETTINGS":"الإعدادات","DV_WINAPP_SETTINGS_DOWNLOADS":"تحميلات برايم فيديو","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_MESSAGE":"عليك الموفقة على شروط الاستخدام لدى {brand} قبل المتابعة.","DV_WINAPP_TERMS_NOT_ACCEPTED_ERROR_TITLE":"لم تتم الموافقة على الشروط"},"com.amazon.dvweb.strings.mxplayer":{},"com.amazon.dvweb.strings.server":{"