    (function (cfg) {
        window.DVWebNode = window.DVWebNode || {};
        var now = function () { return window.performance && performance.now ? Math.round(performance.now()) : 0; };
        // One surface at a time; a press behind a live surface changes nothing.
        DVWebNode.showPreMountFullscreenAutoplay = function (trigger, key) {
            var live = DVWebNode.preMountFullscreenAutoplay;
            if (live && live.state === 'shown') return false;
            var container = document.getElementById('dv-web-player');
            if (!container) {
                container = document.createElement('div');
                container.id = 'dv-web-player';
                document.body.appendChild(container);
            }
            container.classList.add('dv-player-fullscreen');
            var overlay = document.createElement('div');
            overlay.className = 'dv-player-premount';
            overlay.setAttribute('data-testid', 'dv-player-premount');
            var spinner = document.createElement('div');
            spinner.className = 'dv-player-premount-spinner';
            spinner.setAttribute('data-testid', 'dv-player-premount-spinner');
            var ring = document.createElement('img');
            ring.alt = '';
            ring.src = cfg.spinner;
            spinner.appendChild(ring);
            var close = document.createElement('button');
            close.type = 'button';
            close.className = 'dv-player-premount-close';
            close.setAttribute('data-testid', 'dv-player-premount-close');
            close.setAttribute('aria-label', cfg.closeLabel);
            var cross = document.createElement('img');
            cross.alt = '';
            cross.src = cfg.close;
            close.appendChild(cross);
            overlay.appendChild(spinner);
            overlay.appendChild(close);
            container.appendChild(overlay);
            var pageOverflow = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            var record = { trigger: trigger, key: key, state: 'shown', shownAt: now() };
            DVWebNode.preMountFullscreenAutoplay = record;
            // Once the SDK attached, the container and its close button are the SDK's; only a stand-in it never replaced gives up.
            var sdkAttached = container.children.length > 1;
            var giveUp = setTimeout(function () { if (!sdkAttached) end('dismissed', 'timedOut'); }, cfg.timeoutMs);
            // The SDK empties the container at attach; go back underneath so the spinner never blinks.
            var keepUnderneath = new MutationObserver(function () {
                if (!overlay.parentNode) container.insertBefore(overlay, container.firstChild);
                sdkAttached = sdkAttached || container.children.length > 1;
            });
            keepUnderneath.observe(container, { childList: true });
            var end = function (state, reason) {
                if (record.state !== 'shown') return;
                clearTimeout(giveUp);
                keepUnderneath.disconnect();
                record.state = state;
                record.endedAt = now();
                if (reason) record.reason = reason;
                document.removeEventListener('PVVideoPlayerPlay', onPlay);
                document.removeEventListener('PVVideoPlayerClosed', onClose);
                document.removeEventListener('PVPreMountFullscreenAutoplayDismiss', onDismiss);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
                // Only a hand-over keeps the container open; anything else also drops the press the surface stood in for.
                if (state !== 'handedOver') {
                    container.classList.remove('dv-player-fullscreen');
                    document.body.style.overflow = pageOverflow;
                    // The pressed styling goes; the buffered press stays for hydration to log, its ended record stops the replay.
                    if (key && DVWebNode.preMountPlayClick && DVWebNode.preMountPlayClick.clearPressed) DVWebNode.preMountPlayClick.clearPressed();
                }
                // A surface that ends before hydration has no listener yet; the queue keeps its outcome for the observer.
                (DVWebNode.preMountFullscreenAutoplayEnded = DVWebNode.preMountFullscreenAutoplayEnded || []).push(record);
                var ended = document.createEvent('CustomEvent');
                ended.initCustomEvent('PVPreMountFullscreenAutoplayEnded', false, false, record);
                document.dispatchEvent(ended);
            };
            var onPlay = function () { end('handedOver'); };
            var onClose = function () { end('closed'); };
            var onDismiss = function (e) { end('dismissed', e && e.detail && e.detail.reason); };
